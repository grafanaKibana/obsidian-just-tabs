#!/bin/sh

release_inputs="src esbuild.config.mjs package.json package-lock.json tsconfig.json manifest.json styles.css"

if ! git diff --quiet -- $release_inputs ||
	test -n "$(git ls-files --others --exclude-standard -- $release_inputs)"; then
	echo "Release inputs have unstaged changes; stage or stash them before committing." >&2
	exit 1
fi

npm run build &&
	mkdir -p demo/.obsidian/plugins/tabsdown &&
	cp main.js manifest.json styles.css demo/.obsidian/plugins/tabsdown/ &&
	git add \
		demo/.obsidian/plugins/tabsdown/main.js \
		demo/.obsidian/plugins/tabsdown/manifest.json \
		demo/.obsidian/plugins/tabsdown/styles.css
